---
interface Props {
  type?: "note" | "tip" | "warning" | "danger";
  title?: string;
}

const { type = "note", title } = Astro.props;

const defaultTitles: Record<NonNullable<Props["type"]>, string> = {
  note: "Note",
  tip: "Tip",
  warning: "Warning",
  danger: "Important",
};

const heading = title ?? defaultTitles[type];
---

<aside class:list={["callout", `callout-${type}`]} aria-label={heading}>
  <p class="callout-title">{heading}</p>
  <div class="callout-body">
    <slot />
  </div>
</aside>

<style>
  /*
   * Callouts usually render inside `.prose`, whose element selectors are
   * deliberately low-specificity so these scoped rules win without `!important`.
   */
  .callout {
    margin: 1.75rem 0;
    border-left: 2px solid var(--accent);
    background: color-mix(in srgb, var(--accent) 6%, var(--muted));
    padding: 1rem 1.25rem;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  }

  .callout-tip {
    border-left-color: var(--tip);
    background: color-mix(in srgb, var(--tip) 7%, var(--muted));
  }

  .callout-warning {
    border-left-color: var(--warning);
    background: color-mix(in srgb, var(--warning) 8%, var(--muted));
  }

  .callout-danger {
    border-left-color: var(--danger);
    background: color-mix(in srgb, var(--danger) 8%, var(--muted));
  }

  .callout-title {
    margin: 0 0 0.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.4;
    color: var(--accent);
  }

  .callout-tip .callout-title {
    color: var(--tip);
  }

  .callout-warning .callout-title {
    color: var(--warning);
  }

  .callout-danger .callout-title {
    color: var(--danger);
  }

  .callout-body {
    font-size: 1rem;
    line-height: 1.7;
    color: color-mix(in srgb, var(--foreground) 92%, transparent);
  }

  .callout-body :global(p) {
    margin: 0.6rem 0 0;
    font-size: inherit;
    line-height: inherit;
    color: inherit;
  }

  .callout-body :global(p:first-child) {
    margin-top: 0;
  }

  .callout-body :global(a) {
    color: inherit;
    text-decoration-color: currentColor;
  }
</style>
