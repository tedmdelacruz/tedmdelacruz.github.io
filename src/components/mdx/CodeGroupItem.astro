---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<div data-code-tab-panel data-code-tab-label={label}>
  <p class="code-group-fallback-label">{label}</p>
  <slot />
</div>

<style>
  /* !important: guards against `.article-body :global(p)` in [slug].astro
     out-specificity-ing this label when the panel renders inside an article. */
  .code-group-fallback-label {
    margin: 0 0 0.5rem !important;
    font-family: var(--font-mono) !important;
    font-size: 0.72rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.08em !important;
    text-transform: uppercase !important;
    line-height: 1.4 !important;
    color: var(--muted-foreground) !important;
  }
</style>
