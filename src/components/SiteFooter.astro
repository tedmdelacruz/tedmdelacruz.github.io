---
import LocalIcon from "@/components/LocalIcon.astro";
import { footerNavigation, siteConfig } from "@/config/site";

const socialIconByLabel = {
  Instagram: "instagram",
  TikTok: "tiktok",
  YouTube: "youtube",
  RSS: "rss",
} as const;

const socials = siteConfig.socials.map((item) => ({
  ...item,
  icon: socialIconByLabel[item.label as keyof typeof socialIconByLabel] ?? "link-45deg",
}));
const currentYear = new Date().getFullYear();
---

<footer class="outer mt-[var(--space-section)] border-t border-border">
  <div class="inner grid gap-10 py-12 text-center md:grid-cols-3 md:items-center md:gap-8 md:text-left">
    <div>
      <a href="/" class="wordmark">{siteConfig.name}</a>
      <p class="mt-2 text-xs text-muted-foreground">&copy; {currentYear}. All rights reserved.</p>
    </div>

    <div class="flex flex-col items-center gap-5">
      <ul class="flex items-center gap-2.5">
        {
          socials.map((item) => (
            <li>
              <a
                href={item.href}
                class="social-btn"
                aria-label={item.label === "RSS" ? "RSS feed" : `${siteConfig.name} on ${item.label}`}
                rel={item.href.startsWith("http") ? "noreferrer" : undefined}
              >
                <LocalIcon name={item.icon} className="h-[0.95rem] w-[0.95rem]" />
              </a>
            </li>
          ))
        }
      </ul>

      <nav aria-label="Footer navigation">
        <ul class="flex flex-wrap items-center justify-center gap-x-4 gap-y-2">
          {
            footerNavigation.map((item, index) => (
              <li class="flex items-center gap-4">
                {index > 0 && <span class="footer-dot" aria-hidden="true" />}
                <a href={item.href} class="nav-link">{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <p class="text-xs text-muted-foreground md:text-right">
      Built with <a href="https://astro.build/" rel="noreferrer" class="link-quiet underline underline-offset-2">Astro</a>
    </p>
  </div>
</footer>

<style>
  .social-btn {
    display: inline-grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid var(--border);
    color: var(--muted-foreground);
    border-radius: var(--radius-full);
    transition:
      border-color var(--duration) var(--ease-out),
      color var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .social-btn:hover,
  .social-btn:focus-visible {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    color: var(--accent);
    transform: translateY(-2px);
  }

  .footer-dot {
    width: 2px;
    height: 2px;
    background: var(--border-strong);
    border-radius: 50%;
  }
</style>
