---
import { navigation, siteConfig } from "@/config/site";
import { formatDate, postHref, readingLabel, visiblePosts, type Post } from "@/lib/posts";

interface Props {
  posts: Post[];
}

const currentPath = Astro.url.pathname;
const posts = visiblePosts(Astro.props.posts);
/* Inlined so the palette still returns results if /search-index.json fails. */
const searchFallback = posts.slice(0, 12).map((post) => ({
  title: post.data.title,
  excerpt: post.data.excerpt,
  href: postHref(post),
  author: post.data.author.name,
  category: post.data.category,
  date: formatDate(post.data.date),
  reading: readingLabel(post),
}));
const isCurrentPath = (href: string) =>
  currentPath === href || (href !== "/" && currentPath.startsWith(href));
---

<header class="site-header outer">
  <div class="inner flex items-center justify-between gap-6 py-2.5">
    <a href="/" class="wordmark">{siteConfig.name}</a>

    <div class="flex items-center gap-5">
      <nav class="hidden items-center gap-6 md:flex" aria-label="Primary navigation">
        {
          navigation.map((item) => (
            <a
              href={item.href}
              class="nav-link"
              aria-current={isCurrentPath(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-1">
        <a
          href="/search/"
          class="icon-btn"
          aria-label="Search this site"
          aria-haspopup="dialog"
          aria-controls="site-search-dialog"
          data-search-toggle
        >
          <svg aria-hidden="true" class="h-[1.05rem] w-[1.05rem]" viewBox="0 0 24 24" fill="none">
            <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75" />
            <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </a>

        <button
          type="button"
          class="theme-switch ml-1"
          role="switch"
          aria-checked="false"
          data-theme-toggle
          aria-label="Switch to dark mode"
        >
          <span class="theme-switch__knob" aria-hidden="true">
            <svg class="theme-icon-sun" viewBox="0 0 24 24" fill="none">
              <path d="M12 4V2M12 22v-2M4 12H2M22 12h-2M5 5 3.5 3.5M20.5 20.5 19 19M19 5l1.5-1.5M3.5 20.5 5 19" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" />
              <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="2.25" />
            </svg>
            <svg class="theme-icon-moon" viewBox="0 0 24 24" fill="none">
              <path d="M20 14.2A7.4 7.4 0 0 1 9.8 4a8.6 8.6 0 1 0 10.2 10.2Z" stroke="currentColor" stroke-width="2.25" stroke-linejoin="round" />
            </svg>
          </span>
        </button>

        <button
          type="button"
          class="icon-btn md:hidden"
          aria-controls="mobile-menu-panel"
          aria-expanded="false"
          data-mobile-menu-toggle
        >
          <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
          <span class="sr-only">Open navigation menu</span>
        </button>
      </div>
    </div>
  </div>
</header>

<dialog
  id="site-search-dialog"
  class="search-dialog"
  aria-labelledby="site-search-title"
  aria-describedby="site-search-summary"
  data-search-dialog
>
  <div class="search-panel" data-search-panel data-empty>
    <form action="/search/" method="get" role="search" aria-label="Site search">
      <div class="search-field">
        <svg aria-hidden="true" class="search-field-icon" viewBox="0 0 24 24" fill="none">
          <circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.75" />
          <path d="m16 16 4 4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
        <h2 id="site-search-title" class="sr-only">Search {siteConfig.name}</h2>
        <label class="sr-only" for="site-search-input">Search posts</label>
        <input
          id="site-search-input"
          name="q"
          type="search"
          class="search-input"
          placeholder="Search posts, categories, authors…"
          autocomplete="off"
          enterkeyhint="search"
          data-search-input
        />
        <button type="button" class="icon-btn shrink-0" aria-label="Close search" data-search-close>
          <svg aria-hidden="true" class="h-[1.1rem] w-[1.1rem]" viewBox="0 0 24 24" fill="none">
            <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div class="search-body">
        <div class="search-body-head">
          <p class="eyebrow" data-search-heading></p>
          <p id="site-search-summary" class="text-xs text-muted-foreground" data-search-summary aria-live="polite"></p>
        </div>
        <div class="search-results" data-search-results></div>
      </div>

      <div class="search-foot" aria-hidden="true">
        <span><kbd>↑</kbd><kbd>↓</kbd> Navigate</span>
        <span><kbd>↵</kbd> Open</span>
        <span><kbd data-search-shortcut>Ctrl K</kbd> Toggle</span>
        <span class="ml-auto hidden sm:inline">Enter searches everything</span>
      </div>
    </form>
  </div>
</dialog>

<div
  id="mobile-menu-panel"
  class="mobile-menu-panel md:hidden"
  role="dialog"
  aria-modal="true"
  aria-label="Navigation menu"
  hidden
>
  <div class="flex items-center justify-between gap-6 border-b border-border px-6 py-4">
    <a href="/" class="wordmark">{siteConfig.name}</a>
    <button type="button" class="icon-btn" data-mobile-menu-close aria-label="Close navigation menu">
      <svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="none">
        <path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <nav class="px-6 py-4" aria-label="Mobile navigation">
    <ul>
      {
        navigation.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isCurrentPath(item.href) ? "page" : undefined}
              class="block border-b border-border py-4 text-2xl font-semibold tracking-tight aria-[current=page]:text-accent"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</div>

<script is:inline type="application/json" id="site-search-fallback" set:html={JSON.stringify(searchFallback)} />

<script is:inline>
  (() => {
    const dialog = document.querySelector("[data-search-dialog]");
    const toggle = document.querySelector("[data-search-toggle]");
    const closeButton = dialog?.querySelector("[data-search-close]");
    const shortcutKey = dialog?.querySelector("[data-search-shortcut]");
    const input = dialog?.querySelector("[data-search-input]");
    const results = dialog?.querySelector("[data-search-results]");
    const heading = dialog?.querySelector("[data-search-heading]");
    const summary = dialog?.querySelector("[data-search-summary]");
    const panel = dialog?.querySelector("[data-search-panel]");
    const fallback = JSON.parse(document.getElementById("site-search-fallback")?.textContent || "[]");
    let index = [];
    let indexPromise;

    if (shortcutKey && /Mac|iPhone|iPad/.test(navigator.userAgent)) {
      shortcutKey.textContent = "⌘ K";
    }

    /* The full index is fetched on first open, so the palette costs nothing on
       pages the reader never searches from. */
    const loadIndex = () => {
      if (index.length > 0) return Promise.resolve(index);

      indexPromise ??= fetch("/search-index.json")
        .then((response) => {
          if (!response.ok) throw new Error("Search index unavailable");
          return response.json();
        })
        .then((items) => {
          index = Array.isArray(items) && items.length > 0 ? items : fallback;
          return index;
        })
        .catch(() => {
          index = fallback;
          return index;
        });

      return indexPromise;
    };

    const escapeHtml = (value) =>
      String(value).replace(/[&<>"']/g, (character) => ({
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      })[character]);

    /* Lower is better: an exact title prefix beats a title match, which beats a
       category match, which beats a hit in the excerpt or author name. */
    const rank = (item, query) => {
      const title = item.title.toLowerCase();
      const category = (item.category || "").toLowerCase();
      const supporting = [item.excerpt, item.author].join(" ").toLowerCase();

      if (title.startsWith(query)) return 0;
      if (title.includes(query)) return 1;
      if (category.includes(query)) return 2;
      if (supporting.includes(query)) return 3;
      return Number.POSITIVE_INFINITY;
    };

    const resultMarkup = (item) => `
      <a href="${escapeHtml(item.href)}" class="search-result">
        <span class="search-result-title">${escapeHtml(item.title)}</span>
        <span class="search-result-meta">${escapeHtml(item.category || "")} &middot; ${escapeHtml(item.date)} &middot; ${escapeHtml(item.reading || "")}</span>
      </a>
    `;

    const render = async () => {
      if (!input || !results || !heading || !summary) return;

      const raw = input.value.trim();
      const query = raw.toLowerCase();

      /* Until the reader types, the palette collapses to just the input: no
         latest-posts list and no placeholder copy. */
      if (!query) {
        panel?.setAttribute("data-empty", "");
        heading.textContent = "";
        summary.textContent = "";
        results.innerHTML = "";
        return;
      }

      panel?.removeAttribute("data-empty");

      const items = await loadIndex();

      /* A newer keystroke may have landed while the index was loading. */
      if (input.value.trim().toLowerCase() !== query) return;

      const matches = items
        .map((item) => ({ item, score: rank(item, query) }))
        .filter(({ score }) => Number.isFinite(score))
        .sort((a, b) => a.score - b.score)
        .slice(0, 7)
        .map(({ item }) => item);

      heading.textContent = "Results";
      summary.textContent = `${matches.length} ${matches.length === 1 ? "result" : "results"} for “${raw}”.`;
      results.innerHTML =
        matches.length > 0
          ? matches.map(resultMarkup).join("")
          : `<p class="search-empty">No posts match that yet. Try a title, topic, or author.</p>`;
    };

    const open = () => {
      if (!dialog || !input || typeof dialog.showModal !== "function") return;
      if (!dialog.open) dialog.showModal();
      document.documentElement.classList.add("has-open-search");
      void render();
      window.requestAnimationFrame(() => input.focus());
    };

    const close = () => {
      if (dialog?.open) dialog.close();
    };

    toggle?.addEventListener("click", (event) => {
      if (!dialog || typeof dialog.showModal !== "function") return;
      event.preventDefault();
      open();
    });

    closeButton?.addEventListener("click", close);

    dialog?.addEventListener("close", () => {
      document.documentElement.classList.remove("has-open-search");
      toggle?.focus();
    });

    dialog?.addEventListener("click", (event) => {
      if (event.target === dialog) close();
    });

    input?.addEventListener("input", () => void render());

    input?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown") return;
      const first = results?.querySelector("a");
      if (!first) return;
      event.preventDefault();
      first.focus();
    });

    results?.addEventListener("keydown", (event) => {
      if (event.key !== "ArrowDown" && event.key !== "ArrowUp") return;

      const links = Array.from(results.querySelectorAll("a"));
      const current = links.indexOf(document.activeElement);
      if (current === -1) return;

      event.preventDefault();
      if (event.key === "ArrowDown") (links[current + 1] || links[0])?.focus();
      else if (current === 0) input?.focus();
      else links[current - 1]?.focus();
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target;
      const isEditing =
        target instanceof HTMLElement &&
        (target.matches("input, textarea, select") || target.isContentEditable);
      const isCommandShortcut = (event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k";
      const isSlashShortcut =
        event.key === "/" && !isEditing && !event.metaKey && !event.ctrlKey && !event.altKey;

      if (!isCommandShortcut && !isSlashShortcut) return;
      event.preventDefault();

      if (dialog?.open && isCommandShortcut) close();
      else open();
    });

    const header = document.querySelector(".site-header");

    if (header) {
      /* Hide on the way down, reveal on the way back up. The threshold keeps
         small scroll jitter and rubber-banding from flickering the header. */
      const revealThreshold = 6;
      let ticking = false;
      let lastY = window.scrollY;

      const updateHeader = () => {
        const y = window.scrollY;
        const delta = y - lastY;

        header.classList.toggle("is-scrolled", y > 8);

        if (y <= 8) {
          header.classList.remove("is-hidden");
        } else if (delta > revealThreshold) {
          header.classList.add("is-hidden");
        } else if (delta < -revealThreshold) {
          header.classList.remove("is-hidden");
        }

        if (Math.abs(delta) > revealThreshold) lastY = y;
        ticking = false;
      };

      updateHeader();
      window.addEventListener(
        "scroll",
        () => {
          if (ticking) return;
          ticking = true;
          window.requestAnimationFrame(updateHeader);
        },
        { passive: true },
      );
    }

    const menuButton = document.querySelector("[data-mobile-menu-toggle]");
    const menuPanel = document.getElementById("mobile-menu-panel");

    if (menuButton && menuPanel) {
      const menuClose = menuPanel.querySelector("[data-mobile-menu-close]");
      const desktopMedia = window.matchMedia("(min-width: 768px)");
      const focusableSelector =
        'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';
      let inerted = [];

      const setMenuOpen = (isOpen) => {
        menuPanel.hidden = !isOpen;
        menuButton.setAttribute("aria-expanded", String(isOpen));
        document.documentElement.classList.toggle("has-open-menu", isOpen);

        if (isOpen) {
          inerted = Array.from(document.body.children).filter(
            (element) => element !== menuPanel && !element.inert,
          );
          inerted.forEach((element) => {
            element.inert = true;
          });
          window.requestAnimationFrame(() => menuClose?.focus());
        } else {
          inerted.forEach((element) => {
            element.inert = false;
          });
          inerted = [];
        }
      };

      menuButton.addEventListener("click", () => {
        setMenuOpen(menuButton.getAttribute("aria-expanded") !== "true");
      });

      menuPanel.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setMenuOpen(false));
      });

      menuClose?.addEventListener("click", () => {
        setMenuOpen(false);
        menuButton.focus();
      });

      document.addEventListener("keydown", (event) => {
        if (menuPanel.hidden) return;

        if (event.key === "Escape") {
          setMenuOpen(false);
          menuButton.focus();
          return;
        }

        if (event.key !== "Tab") return;

        const focusable = Array.from(menuPanel.querySelectorAll(focusableSelector));
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;

        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      desktopMedia.addEventListener("change", (event) => {
        if (event.matches && !menuPanel.hidden) setMenuOpen(false);
      });
    }
  })();
</script>

<style>
  .search-dialog {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    overflow-y: auto;
    color: var(--foreground);
    border: 0;
    background: transparent;
    padding: clamp(0.75rem, 9vh, 5rem) 1rem 1rem;
  }

  .search-dialog[open] {
    display: grid;
    grid-template-columns: minmax(0, 40rem);
    align-items: start;
    justify-content: center;
  }

  .search-dialog::backdrop {
    background: rgb(0 0 0 / 45%);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .search-panel {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--card);
    border-radius: var(--radius-md);
    box-shadow: 0 24px 60px rgb(0 0 0 / 22%);
  }

  .search-dialog[open] .search-panel {
    animation: search-in 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .search-field {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border);
    padding: 0 1rem;
  }

  .search-field-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex: 0 0 auto;
    color: var(--muted-foreground);
  }

  .search-input {
    width: 100%;
    min-width: 0;
    height: 4rem;
    flex: 1;
    border: 0;
    background: transparent;
    color: var(--foreground);
    outline: none;
    padding: 0;
    font: inherit;
    font-size: 1.0625rem;
  }

  .search-input::placeholder {
    color: var(--muted-foreground);
  }

  .search-input::-webkit-search-cancel-button {
    display: none;
    appearance: none;
  }

  .search-body {
    max-height: min(58vh, 28rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.85rem;
  }

  /* Before the first keystroke the palette is just the input and the shortcut
     hints, so it stays as small as possible. */
  .search-panel[data-empty] .search-body {
    display: none;
  }

  .search-panel[data-empty] .search-field {
    border-bottom-color: transparent;
  }

  .search-body-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0 0.35rem 0.6rem;
  }

  .search-results {
    display: grid;
    gap: 0.1rem;
  }

  .search-results :global(.search-result) {
    display: block;
    min-width: 0;
    padding: 0.65rem 0.75rem;
    color: var(--foreground);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .search-results :global(.search-result:hover),
  .search-results :global(.search-result:focus-visible) {
    background: var(--muted);
    color: var(--accent);
    outline: none;
  }

  .search-results :global(.search-result-title) {
    display: block;
    overflow: hidden;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .search-results :global(.search-result-meta) {
    display: block;
    margin-top: 0.2rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }

  .search-results :global(.search-empty) {
    margin: 0;
    padding: 1.75rem 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .search-foot {
    display: flex;
    align-items: center;
    gap: 1rem;
    border-top: 1px solid var(--border);
    padding: 0.6rem 1rem;
    color: var(--muted-foreground);
    font-size: 0.7rem;
  }

  .search-foot span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-foot kbd {
    display: inline-grid;
    min-width: 1.2rem;
    height: 1.2rem;
    place-items: center;
    border: 1px solid var(--border);
    background: var(--muted);
    color: var(--foreground);
    padding: 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    border-radius: var(--radius-xs);
  }

  @keyframes search-in {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 639px) {
    .search-dialog {
      padding: 0.75rem;
    }

    .search-field {
      gap: 0.6rem;
      padding: 0 0.85rem;
    }

    .search-input {
      height: 3.5rem;
      font-size: 1rem;
    }

    .search-body {
      max-height: calc(100dvh - 9rem);
    }

    .search-body-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
    }

    .search-foot span:nth-child(-n + 2) {
      display: none;
    }
  }
</style>
