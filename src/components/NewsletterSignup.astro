---
import { siteConfig } from "@/config/site";

/*
 * The compact subscribe form used once, in the home sidebar under the About
 * blurb. Monograph deliberately keeps a single signup point rather than
 * repeating a call to action at the end of every page.
 */
const newsletter = siteConfig.newsletter;
const action = newsletter.action.trim();
const isEnabled = newsletter.enabled;
/* No endpoint configured: the form stays interactive and a script confirms the
   submit locally instead of posting the page to nowhere. */
const isDemo = isEnabled && action.length === 0;
---

<section id="newsletter" aria-labelledby="newsletter-heading">
  <h3 id="newsletter-heading" class="text-base font-semibold tracking-tight">{newsletter.title}</h3>
  <p class="mt-2 text-pretty text-sm leading-relaxed text-muted-foreground">{newsletter.description}</p>

  <form
    class="mt-5 grid gap-3"
    action={action || undefined}
    method={newsletter.method}
    data-newsletter-form={isDemo ? "" : undefined}
  >
    <label class="sr-only" for="newsletter-email">Email address</label>
    <input
      id="newsletter-email"
      required
      type="email"
      name={newsletter.emailFieldName}
      autocomplete="email"
      placeholder="you@example.com"
      disabled={!isEnabled}
      class="field"
    />
    <button type="submit" disabled={!isEnabled} class="btn btn-solid btn-block">
      {isEnabled ? "Subscribe" : "Coming soon"}
    </button>
    <p
      class="newsletter-status text-xs leading-relaxed text-muted-foreground"
      role="status"
      aria-live="polite"
      data-newsletter-status
    >
    </p>
    {!isEnabled && (
      <p class="text-xs leading-relaxed text-muted-foreground">
        Signup is disabled until a newsletter provider is configured.
      </p>
    )}
  </form>
</section>

{
  isDemo && (
    <script is:inline>
      document.querySelectorAll("[data-newsletter-form]").forEach((form) => {
        form.addEventListener("submit", (event) => {
          event.preventDefault();
          const status = form.querySelector("[data-newsletter-status]");
          if (status) {
            status.textContent =
              "Thanks. This demo form is not connected to a provider yet, so nothing was sent.";
          }
          form.reset();
        });
      });
    </script>
  )
}

<style>
  .newsletter-status:empty {
    display: none;
  }
</style>
