---
import { getCollection } from "astro:content";
import PostCard from "@/components/PostCard.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { categoryDescriptions } from "@/config/categories";
import { siteConfig } from "@/config/site";
import {
  categories,
  categorySlug,
  getPostsByCategory,
  visiblePosts,
  type Category,
  type Post,
} from "@/lib/posts";

export async function getStaticPaths() {
  const allPosts = visiblePosts(await getCollection("posts"));

  return categories
    .filter((category) => getPostsByCategory(allPosts, category).length > 0)
    .map((category) => ({
      params: { category: categorySlug(category) },
      props: { category, allPosts },
    }));
}

interface Props {
  category: Category;
  allPosts: Post[];
}

const { category, allPosts } = Astro.props;
const posts = getPostsByCategory(allPosts, category);
const description = categoryDescriptions[category];
---

<BaseLayout title={category} description={`${description} ${siteConfig.name} posts in ${category}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Category</p>
        <h1 class="pagehead-title">{category}</h1>
        <p class="pagehead-description">{description}</p>
        <p class="meta mt-5">
          <span>{posts.length} {posts.length === 1 ? "post" : "posts"}</span>
        </p>
      </header>

      <div class="feed">
        {posts.map((post) => <PostCard post={post} />)}
      </div>

      <a href="/categories/" class="btn btn-outline btn-block mt-16">All categories</a>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
