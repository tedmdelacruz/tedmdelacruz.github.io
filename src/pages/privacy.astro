---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Privacy" description={`Privacy policy for ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Privacy</p>
        <h1 class="pagehead-title">Privacy policy</h1>
        <p class="pagehead-description">
          Starter copy describing what a publication may collect and how it is used. Replace it with
          your own policy before going live.
        </p>
      </header>

      <div class="prose">
        <h2>What is collected</h2>
        <p>
          This site is statically generated and sets no cookies of its own. If the newsletter or
          contact form is connected to a provider, that provider receives the details you submit.
        </p>

        <h2>How it is used</h2>
        <p>
          Submitted details are used only to reply to you or to send the emails you asked for. They
          are not sold or shared for advertising.
        </p>

        <h2>Your reading preference</h2>
        <p>
          The light or dark reading mode you pick is stored in your browser's local storage under
          <code>monograph-theme</code>. It never leaves your device and you can clear it at any time.
        </p>

        <h2>Contact</h2>
        {
          siteConfig.email ? (
            <p>For privacy requests, email <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.</p>
          ) : (
            <p>Add a privacy contact address in <code>src/config/site.ts</code> before publishing.</p>
          )
        }
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
