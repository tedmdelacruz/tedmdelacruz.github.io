---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
---

<BaseLayout title="Page not found" description="The page you requested could not be found." noindex>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer grid min-h-[55vh] place-items-center py-16 text-center">
    <div>
      <p class="eyebrow">Error 404</p>
      <h1 class="pagehead-title">Page not found</h1>
      <p class="pagehead-description mx-auto">
        That post may have moved, or the address may be mistyped.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a href="/" class="btn btn-solid">Back to the front page</a>
        <a href="/posts/" class="btn btn-outline">Browse the archive</a>
      </div>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>
