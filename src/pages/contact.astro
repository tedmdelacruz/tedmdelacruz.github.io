---
import { getCollection } from "astro:content";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { siteConfig } from "@/config/site";
import { visiblePosts } from "@/lib/posts";

const allPosts = visiblePosts(await getCollection("posts"));
const contact = siteConfig.contact;
const action = contact.action.trim();
const isEnabled = contact.enabled;
/* No endpoint configured: keep the form usable and confirm the submit locally
   rather than posting the page to nowhere. */
const isDemo = isEnabled && action.length === 0;
---

<BaseLayout title="Contact" description={`Get in touch with ${siteConfig.name}.`}>
  <SiteHeader posts={allPosts} />
  <main id="content" class="outer">
    <div class="canvas">
      <header class="pagehead">
        <p class="eyebrow">Contact</p>
        <h1 class="pagehead-title">Get in touch</h1>
        <p class="pagehead-description">
          Corrections, questions, and requests all land in the same inbox. {contact.responseTime}
        </p>
        {
          siteConfig.email && (
            <p class="mt-4 text-sm text-muted-foreground">
              Prefer email? Write to <a href={`mailto:${siteConfig.email}`} class="text-accent underline underline-offset-2">{siteConfig.email}</a>.
            </p>
          )
        }
      </header>

      <form
        class="grid gap-5"
        action={action || undefined}
        method={contact.method}
        data-contact-form={isDemo ? "" : undefined}
      >
        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-name">Name</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-email">Email</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" required disabled={!isEnabled} class="field" />
        </div>

        <div class="grid gap-2">
          <label class="text-sm font-semibold" for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="7" required disabled={!isEnabled} class="field resize-y"></textarea>
        </div>

        <div class="flex flex-wrap items-center gap-4">
          <button type="submit" disabled={!isEnabled} class="btn btn-solid">
            {isEnabled ? "Send message" : "Form unavailable"}
          </button>
          <p class="contact-status text-sm leading-relaxed text-muted-foreground" role="status" aria-live="polite" data-contact-status></p>
        </div>

        {
          !isEnabled && (
            <p class="text-sm leading-relaxed text-muted-foreground">
              This form is disabled until a form endpoint is configured in <code>siteConfig.contact</code>.
            </p>
          )
        }
      </form>
    </div>
  </main>
  <SiteFooter />

  {
    isDemo && (
      <script is:inline>
        document.querySelectorAll("[data-contact-form]").forEach((form) => {
          form.addEventListener("submit", (event) => {
            event.preventDefault();
            const status = form.querySelector("[data-contact-status]");
            if (status) {
              status.textContent =
                "Thanks. This demo form is not connected to an endpoint yet, so nothing was sent.";
            }
            form.reset();
          });
        });
      </script>
    )
  }

  <style>
    .contact-status:empty {
      display: none;
    }
  </style>
</BaseLayout>
